#!/usr/bin/env python3
"""omega — CryoOmega ULTRA unified CLI (v0.2.1 OmniLink)."""
import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from ultra import __version__, client, config, doctor, gateway, skills, tui  # noqa: E402


def _gw():
    """Ensure the gateway engine is reachable (auto-spawn when down)."""
    if not gateway.ensure_running():
        print("✘ gateway unreachable — check ~/.omega/gateway.log", file=sys.stderr)
        sys.exit(2)


def cmd_chat(args):
    if args.web:
        return cmd_ide(args)
    _gw()
    tui.run()


def cmd_agent(args):
    _gw()
    res = client.agent_run(args.agent or "orchestrator", args.task)
    print(f"engine: {res.get('engine')} · agent: {res.get('agent')}")
    if res.get("provider"):
        print(f"provider: {res['provider']} · model: {res.get('model')}")
    print(res.get("output") or res.get("error", ""))


def cmd_agents(args):
    _gw()
    action = args.action
    if action == "list":
        rows = client.agents_list()
        if isinstance(rows, dict):
            print(rows.get("error", "gateway error"))
            return
        for a in rows:
            off = "" if a.get("enabled", True) else "  (disabled)"
            print(f"  {a['name']:<20}{(a.get('persona') or '')[:64]}{off}")
        print(f"\n({len(rows)} agent profiles · {config.AGENTS_JSON})")
    elif action == "info":
        p = client.agent_info(args.name)
        print(json.dumps(p, indent=2) if "error" not in p else p["error"])
    elif action == "run":
        res = client.agent_run(args.name, args.task)
        print(res.get("output") or res.get("error", ""))
    elif action == "add":
        p = client.agent_add(args.name, persona=args.persona,
                             provider=args.provider, model=args.model,
                             tags=args.tags, enabled=not args.disabled)
        print(f"agent → {p.get('id', p.get('error'))}")
    elif action == "rm":
        res = client.agent_remove(args.name)
        print(f"removed {args.name}" if res.get("removed")
              else f"{args.name} not found")


def cmd_skills(args):
    _gw()
    if args.action == "list":
        items = client.skills()
        if isinstance(items, dict):
            print(items.get("error", "gateway error"))
            return
        for s in items:
            print(f"  {s['name']:<42} {s['description']}")
        print(f"\n({len(items)} skills installed)")
    elif args.action == "search":
        hits = client.skills(args.target)
        if isinstance(hits, dict):
            print(hits.get("error", "gateway error"))
            return
        for s in hits:
            print(f"  {s['name']:<42} {s['description']}")
        print(f"\n({len(hits)} matches)")
    elif args.action == "add":
        res = client.skills_install(args.target)
        if res.get("error"):
            print(f"✘ {res['error']}")
            return
        installed = res.get("installed", [])
        print(f"installed {len(installed)} skill(s):")
        for n in installed:
            print(f"  + {n}")
    elif args.action == "info":
        meta, body = skills.info(args.target)
        print(json.dumps(meta, indent=2))
        print("\n" + body)


def cmd_plan(args):
    _gw()
    res = client.plan(args.task)
    print(res.get("text") or res.get("error", ""))


def cmd_doctor(args):
    checks = doctor.run()
    hard_fail = False
    soft_fail = False
    for name, ok, note, hard in checks:
        if ok:
            mark = "✔"
        elif hard:
            mark = "✘"
            hard_fail = True
        else:
            mark = "!"
            soft_fail = True
        tag = "" if ok or not hard else " [hard]"
        if not ok and not hard:
            tag = " [soft]"
        print(f"  {mark} {name:<14} {note}{tag}")
    if hard_fail:
        print("\n Doctor: HARD FAIL (exit 1)")
        sys.exit(1)
    if soft_fail:
        print("\n Doctor: OK with soft warnings")
    else:
        print("\n Doctor: ALL GREEN")


def cmd_init(args):
    target = Path(args.dir or ".").resolve()
    yml = target / ".omega.yaml"
    yml.write_text(
        f"# CryoOmega ULTRA project config\n"
        f"provider: {config.DEFAULTS['provider']}\n"
        f"model: {config.DEFAULTS['model']}\n"
        f"port: {config.DEFAULTS['port']}\n"
        f"safemode_level: {config.DEFAULTS['safemode_level']}\n")
    print(f"wrote {yml}")


def cmd_gateway(args):
    action = args.action
    if action == "status":
        if not client.is_up():
            print("gateway: DOWN — run `omega gateway start`")
            return
        s = client.status()
        print(f"gateway: UP · {s.get('engine')} v{s.get('version')} · "
              f"uptime {s.get('uptime_s')}s")
        print(f"  root     {s.get('root')}")
        print(f"  registry {s.get('skills')} skills · {s.get('agents')} agents · "
              f"{len(s.get('plugins') or [])} plugins")
        prov = " ".join(f"{p}:{'✓' if k else '·'}"
                        for p, k in (s.get("providers") or {}).items())
        print(f"  providers {prov}")
    elif action == "start":
        print("gateway: started" if gateway.ensure_running()
              else "gateway: failed to start — see ~/.omega/gateway.log")
    elif action == "stop":
        print("gateway: stopped" if gateway.stop()
              else "gateway: not running (no pid file)")
    elif action == "restart":
        gateway.stop()
        time.sleep(0.6)
        print("gateway: restarted" if gateway.ensure_running()
              else "gateway: restart failed")
    elif action == "log":
        p = config.GATEWAY_LOG
        if p.exists():
            lines = p.read_text(errors="replace").splitlines()
            print("\n".join(lines[-int(args.lines or 30):]) or "(empty)")
        else:
            print("(no gateway log yet)")


def cmd_serve(args):
    gateway.serve(port=args.port)


def cmd_ide(args):
    _gw()
    port = args.port or config.GATEWAY_PORT
    url = f"http://127.0.0.1:{port}"
    for opener in ("termux-open-url", "xdg-open"):
        if subprocess.run([opener, url], capture_output=True).returncode == 0:
            break
    print(f"IDE at {url} (gateway engine)")


def cmd_plugin(args):
    _gw()
    action = args.action
    if action == "list":
        rows = client.plugins()
        if isinstance(rows, dict) and rows.get("error"):
            print(rows.get("error"))
            return
        for name, meta in rows.items():
            mark = "" if meta.get("enabled", True) else "  (disabled)"
            print(f"  {name:<20} v{meta.get('version') or '?'} "
                  f"[{meta.get('runtime')}]{mark} {(meta.get('description') or '')[:48]}")
        print(f"\n({len(rows)} plugins · {config.PLUGINS_DIR})")
    elif action == "install":
        res = client.plugin_install(args.target)
        if res.get("error"):
            print(f"✘ {res['error']}")
            return
        for n in res.get("installed", []):
            print(f"  + {n}")
        print("restart the gateway to activate: omega gateway restart")
    elif action == "info":
        rows = client.plugins()
        meta = (rows or {}).get(args.target)
        print(json.dumps(meta, indent=2) if meta
              else f"plugin {args.target} not found")
    elif action in ("enable", "disable"):
        res = client.plugin_enable(args.target, action == "enable")
        print(f"plugin {args.target}: enabled={res.get('enabled')} · "
              f"restart gateway to apply to running routes")
    elif action == "rm":
        res = client.plugin_remove(args.target)
        print("removed" if res.get("removed")
              else f"plugin {args.target} not found")


def main():
    p = argparse.ArgumentParser(prog="omega", description="CryoOmega ULTRA CLI")
    p.add_argument("--version", action="version", version=f"omega {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    ch = sub.add_parser("chat", help="interactive TUI chat")
    ch.add_argument("--web", action="store_true", help="launch the Web IDE instead")
    ch.set_defaults(func=cmd_chat)

    sp = sub.add_parser("agent", help="dispatch task to an agent (default: orchestrator)")
    sp.add_argument("task")
    sp.add_argument("--agent", default=None)
    sp.set_defaults(func=cmd_agent)

    ag = sub.add_parser("agents", help="agent registry")
    ag.add_argument("action", choices=["list", "info", "run", "add", "rm"])
    ag.add_argument("name", nargs="?", default="")
    ag.add_argument("task", nargs="?", default="")
    ag.add_argument("--persona", default=None)
    ag.add_argument("--provider", default=None)
    ag.add_argument("--model", default=None)
    ag.add_argument("--tags", default=None, help="comma-separated tags")
    ag.add_argument("--disabled", action="store_true")
    ag.set_defaults(func=cmd_agents)

    sk = sub.add_parser("skills", help="skills engine")
    sk.add_argument("action", choices=["list", "search", "add", "info"])
    sk.add_argument("target", nargs="?", default="")
    sk.set_defaults(func=cmd_skills)

    sp = sub.add_parser("plan", help="draft plan brief")
    sp.add_argument("task")
    sp.set_defaults(func=cmd_plan)

    sub.add_parser("doctor", help="health check").set_defaults(func=cmd_doctor)

    ip = sub.add_parser("init", help="write .omega.yaml")
    ip.add_argument("--dir", default=None)
    ip.set_defaults(func=cmd_init)

    gw = sub.add_parser("gateway", help="engine service control")
    gw.add_argument("action", choices=["status", "start", "stop", "restart", "log"])
    gw.add_argument("--lines", type=int, default=30, help="log tail lines")
    gw.set_defaults(func=cmd_gateway)

    sv = sub.add_parser("serve", help="run the gateway in the foreground")
    sv.add_argument("--port", type=int, default=None)
    sv.set_defaults(func=cmd_serve)

    iv = sub.add_parser("ide", help="launch the Web IDE")
    iv.add_argument("--port", type=int, default=None)
    iv.set_defaults(func=cmd_ide)

    pl = sub.add_parser("plugin", help="gateway plugins")
    pl.add_argument("action", choices=["list", "install", "info", "enable", "disable", "rm"])
    pl.add_argument("target", nargs="?", default="")
    pl.set_defaults(func=cmd_plugin)

    args = p.parse_args()
    if args.cmd == "agent" and not args.task:
        p.error("agent requires a task")
    if args.cmd == "agents" and args.action in ("info", "run", "add", "rm") and not args.name:
        p.error(f"agents {args.action} requires a name")
    if args.cmd == "agents" and args.action == "run" and not args.task:
        p.error("agents run requires a task")
    if args.cmd == "skills" and args.action in ("search", "add", "info") and not args.target:
        p.error(f"skills {args.action} requires a target")
    if args.cmd == "plugin" and args.action != "list" and not args.target:
        p.error(f"plugin {args.action} requires a target")
    args.func(args)


if __name__ == "__main__":
    main()