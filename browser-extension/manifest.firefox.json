{
  "manifest_version": 3,
  "name": "Cryo Omega Promoter Suite",
  "version": "1.1.0",
  "description": "Cryo Promoter Suite and Download Manager.",
  "action":{"default_title":"Cryo Omega","default_popup":"src/popup.html"},
  "background":{"scripts":["src/background.js"],"persistent":false},
  "permissions":["downloads","storage","contextMenus","notifications","tabs"],
  "host_permissions":["<all_urls>"],
  "options_ui":{"page":"src/options.html","open_in_tab":true},
  "commands":{"open-manager":{"suggested_key":{"default":"Ctrl+Shift+Y"},"description":"Open Cryo Download Manager"}},
  "browser_specific_settings":{"gecko":{"id":"cryo-omega-promoter@pierreg99.github.io","strict_min_version":"109.0"}}
}
