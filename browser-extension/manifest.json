{
  "manifest_version": 3,
  "name": "Cryo Omega Promoter Suite",
  "version": "1.1.0",
  "description": "Cryo Promoter Suite and Download Manager for modern browsers.",
  "action": {"default_title":"Cryo Omega","default_popup":"src/popup.html"},
  "background": {"service_worker":"src/background.js","type":"module"},
  "permissions":["downloads","storage","contextMenus","notifications","tabs"],
  "host_permissions":["<all_urls>"],
  "icons":{"16":"assets/icon16.png","32":"assets/icon32.png","48":"assets/icon48.png","128":"assets/icon128.png"},
  "options_page":"src/options.html",
  "commands":{"open-manager":{"suggested_key":{"default":"Ctrl+Shift+Y"},"description":"Open Cryo Download Manager"}}
}
