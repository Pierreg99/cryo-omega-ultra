# CryoOmega ULTRA — copy to .env locally; never commit real keys.

# Paths
# OMEGA_ROOT=/path/to/cryo-omega-ultra
# OMEGA_DATA=~/.omega
# OMEGA_CONFIG=.omega.yaml

# Gateway (default loopback only)
OMEGA_GATEWAY_PORT=8787
# OMEGA_GATEWAY_HOST=127.0.0.1
# Non-loopback binds are refused unless:
# OMEGA_GATEWAY_ALLOW_REMOTE=1

# LLM providers (env-only; never written to ~/.omega)
# CRYOMEGA_PROVIDER=minimax
# CRYOMEGA_MODEL=minimax-m3
# CRYOMEGA_MINIMAX_KEY=
# CRYOMEGA_MINIMAX_URL=https://api.minimax.io/v1
# CRYOMEGA_ANTHROPIC_KEY=
# CRYOMEGA_ANTHROPIC_URL=https://api.anthropic.com/v1
# CRYOMEGA_OPENAI_KEY=
# CRYOMEGA_OPENAI_URL=https://api.openai.com/v1
